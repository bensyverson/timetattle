#!/bin/bash
# Exercise the release/install contract end to end, offline, without notary
# credentials.
#
# WHY THIS EXISTS. scripts/release.sh writes a checksum file naming the dmg
# after the commit (timetattle-<sha>.dmg); scripts/install.sh downloaded to a
# fixed local name and then ran `shasum -a 256 -c` on the published file, which
# re-opens whatever FILENAME the checksum names. That file was never present,
# so `shasum -c` reported "FAILED open or read" and install.sh aborted under
# `set -e` -- on EVERY release, before it mounted anything. Both scripts were
# individually tested on 2026-08-02 and both were individually fine. Nothing
# had ever run one against the output of the other. This script is the thing
# that would have caught it, so it runs the REAL scripts rather than a copy of
# their steps.
#
# WHAT IT PROVES, AND WHAT IT CANNOT. It proves the produce/consume contract:
# that install.sh can resolve, download, checksum, mount and signature-verify
# an artifact release.sh actually produced. It CANNOT prove notarization, and
# it does not pretend to -- with no credentials the artifact is unnotarized, so
# the expected outcome is that install.sh gets all the way to the notarization
# check and is correctly REJECTED there. Reaching that point is the pass
# condition today; reaching it is also not a clean-machine Gatekeeper test and
# is not a substitute for one.
#
# IT NEVER EXECUTES THE BINARY IT INSTALLS. Running a freshly signed or
# quarantined artifact can raise a real Gatekeeper dialog on the user's
# desktop, which happened during testing on 2026-08-02. Assessment only.
#
#   scripts/releasecheck                 # package a fresh unnotarized dmg, test it
#   scripts/releasecheck path/to/x.dmg   # test an EXISTING dmg (e.g. a real
#                                        # notarized one, after credentials exist)
#
# Exit: 0 contract holds, 1 contract broken, 2 skipped (precondition missing).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORK="$REPO_ROOT/dist/releasecheck"
GIVEN_DMG="${1:-}"

skip() {
	echo "SKIP: $*" >&2
	exit 2
}
fail() {
	echo "FAIL: $*" >&2
	exit 1
}

# --- preconditions. A skip names what was MISSING, not what it concluded. ---
[ "$(uname -s)" = "Darwin" ] || skip "not macOS; codesign/hdiutil/spctl are unavailable"
command -v hdiutil >/dev/null 2>&1 || skip "hdiutil is not on PATH"

if [ -z "$GIVEN_DMG" ]; then
	if ! security find-identity -v -p codesigning 2>/dev/null | grep -qF 'Developer ID Application'; then
		skip "no 'Developer ID Application' identity in the keychain, so scripts/release.sh cannot produce an artifact to test against"
	fi
	if [ -n "$(cd "$REPO_ROOT" && git status --porcelain)" ]; then
		skip "working tree is not clean, and scripts/release.sh refuses to build from one (commit or stash first)"
	fi
fi

rm -rf "$WORK"
mkdir -p "$WORK"

# --- 1. produce, using the real release script ------------------------------
if [ -n "$GIVEN_DMG" ]; then
	[ -f "$GIVEN_DMG" ] || fail "$GIVEN_DMG does not exist"
	[ -f "$GIVEN_DMG.sha256" ] || fail "$GIVEN_DMG.sha256 does not exist; a release must publish the checksum sibling"
	DMG="$(cd "$(dirname "$GIVEN_DMG")" && pwd)/$(basename "$GIVEN_DMG")"
	echo "==> using the dmg given on the command line: $DMG"
else
	echo "==> packaging an unnotarized dmg with scripts/release.sh"
	TIMETATTLE_UNNOTARIZED_PACKAGE=1 TIMETATTLE_RELEASE_DIR="$WORK/dist" \
		"$REPO_ROOT/scripts/release.sh" >"$WORK/release.log" 2>&1 ||
		{
			cat "$WORK/release.log" >&2
			fail "scripts/release.sh did not complete its packaging path"
		}
	# -print -quit rather than `| head -1`: under `set -o pipefail`, head closing
	# the pipe early can leave find killed by SIGPIPE and the whole command
	# substitution non-zero, which `set -e` would then treat as a failure.
	DMG="$(find "$WORK/dist" -maxdepth 1 -name '*.dmg' -print -quit)"
	[ -n "$DMG" ] || fail "scripts/release.sh produced no .dmg (see $WORK/release.log)"
	[ -f "$DMG.sha256" ] || fail "scripts/release.sh produced $DMG but no $DMG.sha256 sibling"
fi

echo "    dmg:      $(basename "$DMG")"
echo "    checksum: $(cat "$DMG.sha256")"

# --- 2. consume, using the real install script ------------------------------
# file:// rather than a fake HTTP server: curl resolves it, so the download
# path under test is the same code as a real release, and no network or
# published release is needed.
echo "==> installing it with scripts/install.sh (into a scratch dir, never onto PATH)"
set +e
TIMETATTLE_DMG_URL="file://$DMG" TIMETATTLE_INSTALL_DIR="$WORK/bin" \
	"$REPO_ROOT/scripts/install.sh" >"$WORK/install.log" 2>&1
install_status=$?
set -e
sed 's/^/    | /' "$WORK/install.log"

# --- 3. judge, on how far it got, not on the exit code alone ----------------
reached() { grep -qF "$1" "$WORK/install.log"; }

reached '==> verifying checksum' || fail "install.sh never reached the checksum step"
reached 'sha256 ok' || fail "install.sh could not verify the checksum of a dmg release.sh had just produced -- this is the exact regression this script exists for (see the header)"
reached '==> mounting' || fail "install.sh verified the checksum but never mounted the dmg"
reached '==> verifying signature' || fail "install.sh mounted the dmg but never found an executable to verify in it"
reached '==> verifying notarization' || fail "install.sh found the binary but its signature did not verify"

if [ "$install_status" -eq 0 ]; then
	echo
	echo "PASS: install.sh completed. The dmg is notarized and the installed copy is at"
	echo "      $WORK/bin/timetattle (not executed here, and not on PATH)."
	echo "      This is still not the acceptance test: that requires a machine which has"
	echo "      never seen this code."
	exit 0
fi

if grep -qF 'Unnotarized Developer ID' "$WORK/install.log"; then
	echo
	echo "PASS (to the expected wall): install.sh resolved, downloaded, checksum-verified,"
	echo "      mounted and signature-verified the artifact, then correctly REJECTED it at"
	echo "      the notarization check with 'source=Unnotarized Developer ID'."
	echo
	echo "      That rejection is the right answer for this artifact: no notary credentials"
	echo "      are stored, so nothing here is notarized. The produce/consume contract holds."
	echo "      Nothing about Gatekeeper on another machine is demonstrated by this."
	exit 0
fi

fail "install.sh failed at the notarization check for a reason other than the artifact being unnotarized (exit $install_status; see $WORK/install.log)"
