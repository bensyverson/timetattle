#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# THE CONFIDENTIALITY GATE RUNS FIRST, and both halves of that are deliberate.
#
# THAT IT RUNS HERE AT ALL. scripts/confidential works and, until this step
# existed, nothing ran it: it was invoked by hand, twice, four days apart, and
# in the three days between two commits landed three client-name leaks in
# published documents. The interval between a leak landing and a human
# happening to look was unbounded, and the pressure is constant rather than
# occasional -- this project's house style asks agents to paste real `metrics`
# and `review` output into project/ documents, while the live store and the
# registry markers still hold the REAL names the repository was scrubbed of.
#
# A hook rather than CI, and this is the part that is NOT the usual trade-off.
# The names deliberately do not live in the repository, so the only machine
# that can run this check is the one holding ~/.timetattle. A CI runner would
# necessarily run it with no name source at all -- which now exits 2 saying so,
# rather than reporting clean, but a step that can only ever be red or silent
# is not a gate. Putting the real client names into a CI secret would publish
# the list into a third party to protect it from being published, and on a
# public repository a fork's pull request does not get secrets, so the check
# would go nameless exactly on untrusted input. A hook is bypassable with
# --no-verify and absent on a fresh clone; those are real limits, and they are
# limits on an accident detector, which is what this is. See
# docs/content/docs/confidentiality.md.
#
# THAT IT RUNS BEFORE THE TESTS. Everything below takes minutes; this takes
# seconds, and it is the only check here whose failure cannot be fixed by
# amending afterwards -- once a real client name is in a commit object it is in
# the history, and -git object scans exist precisely because an amended-away
# commit is still sitting in .git/objects.
echo "==> confidentiality gate"
# BUILT, NOT `go run`. `go run` reports a program's non-zero exit as "exit
# status N" on stderr and exits 1 itself, which collapses this gate's two
# failures -- "found something" and "could not tell" -- into one code. Those
# two need different sentences from the hook, and the whole point of exit 2 is
# that it is not a pass and not a finding. -buildvcs=false for the reason the
# `go build` step below gives: in a worktree the toolchain resolves the bare
# main repository and `git status` fails against it.
gate_bin="$(mktemp -d)/confidential"
go build -buildvcs=false -o "$gate_bin" ./scripts/confidential
set +e
"$gate_bin" -staged -gate
gate_status=$?
set -e
rm -rf "$(dirname "$gate_bin")"
if [ "$gate_status" -eq 2 ]; then
  echo ""
  echo "The gate could not build its list, so it has NOT said this commit is clean."
  echo "It says only that it could not tell. Fix whatever it named above; if this is"
  echo "a fresh clone, the usual cause is that no name has been classified yet:"
  echo ""
  echo "  go run ./scripts/confidential -classify > ~/.timetattle/publication-gate.json"
  echo ""
  echo "Read that file before saving it: a name that identifies a client belongs in"
  echo "scripts/pseudonymize, not in a list of things declared safe to publish."
  exit 1
elif [ "$gate_status" -ne 0 ]; then
  echo ""
  echo "This commit ADDS material that must not be published. The findings above are"
  echo "the ones this commit introduces; anything listed as carried was already at"
  echo "HEAD and is not what is blocking you."
  echo ""
  echo "A client name usually arrives here by pasting live output into a document."
  echo "Pseudonymise it (scripts/pseudonymize) rather than deleting the measurement."
  exit 1
fi

echo "==> go vet"
go vet ./...

# Analysis tools in scripts/ are ordinary subdirectory packages — one per
# directory, each its own `package main` — so `go vet ./...` above already
# covers them and they are tested like anything else.
#
# This guard exists because that convention is easy to break by accident. A
# loose `scripts/foo.go` carrying `//go:build ignore` would vanish from
# `./...` entirely: it would never be vetted, never be built, and could rot
# silently until someone tried to run it. Rather than special-case such files
# the way this hook did when it was inherited, refuse them and point at the
# convention that keeps them covered.
echo "==> scripts/ layout"
shopt -s nullglob
loose_scripts=(scripts/*.go)
shopt -u nullglob
if [ ${#loose_scripts[@]} -gt 0 ]; then
  echo "these files sit loose in scripts/ and are invisible to go vet ./... :"
  printf '  %s\n' "${loose_scripts[@]}"
  echo ""
  echo "Give each one its own directory so it is covered like the rest:"
  echo "  mkdir scripts/<name> && git mv scripts/<name>.go scripts/<name>/main.go"
  exit 1
fi

echo "==> go fix"
# `go fix` can rewrite files in place without printing to stdout (the
# Go 1.22+ loop/modernizers in particular). Capturing stdout isn't enough —
# silent rewrites slip through and land as follow-up commits. Compare the
# worktree against the staged set instead: any modification by `go fix` to a
# file already part of this commit is a hard fail with a re-stage hint.
#
# `go fix` also applies OVERLAPPING fixes across SEVERAL PASSES: when two
# analyzers target the same region (a map-append loop that is then sorted,
# say) it applies what it can, prints "(Re-run the command to apply more.)"
# and exits NON-ZERO. Under `set -e` that single informational exit aborted
# the commit even though nothing was wrong and the check below would pass.
# So iterate to convergence, and only then let a still-failing run stand as
# a real failure.
for _ in 1 2 3 4 5; do
  if go fix ./... > /dev/null 2>&1; then break; fi
done
go fix ./... > /dev/null
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged" ]; then
  # `git diff -- <staged paths>` reports unstaged changes scoped to those
  # paths; unrelated worktree edits don't trip the hook.
  modified=$(git diff --name-only -- $staged)
  if [ -n "$modified" ]; then
    echo "go fix modified staged files:"
    echo "$modified"
    echo ""
    echo "Re-stage and commit again:"
    echo "  git add $(echo $modified | tr '\n' ' ') && git commit ..."
    exit 1
  fi
fi

echo "==> gofmt"
# DOT-DIRECTORIES ARE EXCLUDED, and that is load-bearing rather than tidy.
# `gofmt -l .` recurses everywhere, including `.claude/worktrees/`, where
# parallel subagents keep their IN-PROGRESS checkouts. A teammate's half-typed
# file would then fail THIS commit, in a repo whose whole workflow is fanning
# work out to worktree agents — so a running agent could block the main thread
# for a reason that has nothing to do with what is being committed.
#
# Excluding `./.*` matches what the Go toolchain itself does (it ignores
# directories beginning with `.` or `_`), which is why `go vet ./...` and
# `go test ./...` never had this problem and only gofmt did.
unformatted=$(find . -name '*.go' -not -path './.*' -exec gofmt -l {} +)
if [ -n "$unformatted" ]; then
  echo "gofmt needs to format these files:"
  echo "$unformatted"
  echo ""
  echo "Run: gofmt -w ."
  exit 1
fi

echo "==> go mod tidy"
go mod tidy
if ! git diff --quiet go.mod go.sum 2>/dev/null; then
  echo "go.mod or go.sum changed after go mod tidy"
  echo "Run: go mod tidy && git add go.mod go.sum"
  exit 1
fi

echo "==> go test"
go test ./...

echo "==> go build"
# -buildvcs=false: this check only needs to know the code builds. Without it,
# building cmd/timetattle's binary makes the toolchain embed VCS info, which
# means running `git status` against whatever it resolves as the repository
# root — and for a worktree checkout it resolves that as the BARE main
# repository (this project's own layout), which has no working tree to run
# status against and fails with exit 128. Reproduces on a clean, already
# committed HEAD with none of a given change's edits applied, so it is not
# something any one commit can fix by changing source; only the query itself
# can be skipped.
go build -buildvcs=false ./...

echo ""
echo "All checks passed."
